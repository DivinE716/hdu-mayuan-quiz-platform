# ============================================================
#  服务器部署凭证
#  复制此文件为 .env.deploy 并填入真实信息
# ============================================================

SERVER_IP=120.26.138.61
SERVER_USER=root

# ---- 方式一：使用 SSH 密钥登录（推荐） ----
SSH_KEY=~/.ssh/id_rsa

# ---- 方式二：使用密码登录 ----
# 如果使用密码，请注释掉上面的 SSH_KEY，取消下面的注释：
# SSH_PASSWORD=你的服务器密码

# ---- 管理员后台 Token ----
# 在服务器 .env 中设置，访问 /admin-dashboard 时需要输入
# ADMIN_TOKEN=your-secret-token-here
