generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  username        String          @unique
  passwordHash    String
  createdAt       DateTime        @default(now())
  lastSingleId    String?         // 单选题最后做到哪一题
  lastMultipleId  String?         // 多选题最后做到哪一题
  lastJudgmentId  String?         // 判断题最后做到哪一题
  progress        UserProgress[]
  settings        UserSettings[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Question {
  id           String         @id @default(cuid())
  type         String         // "single" | "multiple" | "judge"
  questionText String
  options      String         // JSON string array
  answer       String         // JSON array of correct answer indices
  analysisText String
  progress     UserProgress[]
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  isFavorite Boolean  @default(false)
  wrongCount Int      @default(0)
  isMastered Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}
